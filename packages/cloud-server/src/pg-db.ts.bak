/**
 * Postgres 后端（Supabase / Neon / 自建 PG）
 * users + tokens + sync_objects（密文 BYTEA）
 * 无持久卷时也可运行：一切入 DATABASE_URL
 */

import { randomBytes, scryptSync, timingSafeEqual, createHash } from "node:crypto";
import { Pool, type QueryResultRow } from "pg";
import { PLANS, type PlanId } from "@sessionharbor/core";
import { ApiError } from "./db.js";

function hashPassword(password: string, salt: Buffer): string {
  return scryptSync(password, salt, 32, { N: 16384, r: 8, p: 1 }).toString("base64");
}

function verifyPassword(password: string, salt: Buffer, expected: string): boolean {
  const a = Buffer.from(hashPassword(password, salt), "base64");
  const b = Buffer.from(expected, "base64");
  if (a.length !== b.length) return false;
  return timingSafeEqual(a, b);
}

function sha256(s: string): string {
  return createHash("sha256").update(s).digest("hex");
}

export interface PgConfig {
  connectionString: string;
}

const SCHEMA = `
CREATE TABLE IF NOT EXISTS harbor_users (
  id TEXT PRIMARY KEY,
  email TEXT UNIQUE NOT NULL,
  password_hash TEXT NOT NULL,
  password_salt TEXT NOT NULL,
  plan TEXT NOT NULL DEFAULT 'free',
  created_at BIGINT NOT NULL,
  updated_at BIGINT NOT NULL,
  disabled INTEGER NOT NULL DEFAULT 0,
  email_verified INTEGER NOT NULL DEFAULT 0,
  verify_code TEXT,
  verify_expires BIGINT
);
CREATE TABLE IF NOT EXISTS harbor_tokens (
  token_hash TEXT PRIMARY KEY,
  user_id TEXT NOT NULL REFERENCES harbor_users(id) ON DELETE CASCADE,
  created_at BIGINT NOT NULL,
  last_used_at BIGINT,
  revoked_at BIGINT
);
CREATE INDEX IF NOT EXISTS idx_harbor_tokens_user ON harbor_tokens(user_id);
CREATE TABLE IF NOT EXISTS harbor_objects (
  user_id TEXT NOT NULL REFERENCES harbor_users(id) ON DELETE CASCADE,
  path TEXT NOT NULL,
  body BYTEA NOT NULL,
  bytes INTEGER NOT NULL,
  mtime BIGINT NOT NULL,
  PRIMARY KEY (user_id, path)
);
`;

export class PgCloudDatabase {
  private pool: Pool;

  constructor(cfg: PgConfig) {
    this.pool = new Pool({ connectionString: cfg.connectionString, max: 10 });
  }

  async init(): Promise<void> {
    await this.pool.query(SCHEMA);
  }

  async close(): Promise<void> {
    await this.pool.end();
  }

  async register(
    email: string,
    password: string,
  ): Promise<{
    userId: string;
    token: string;
    plan: PlanId;
    emailVerified: boolean;
    verifyCode?: string;
  }> {
    if (!email.includes("@")) throw new ApiError("邮箱格式不正确", 400);
    if (password.length < 6) throw new ApiError("密码至少 6 位", 400);
    const exists = await this.pool.query(`SELECT id FROM harbor_users WHERE email = $1`, [email]);
    if (exists.rowCount) throw new ApiError("邮箱已注册", 409);
    const userId = randomBytes(16).toString("hex");
    const salt = randomBytes(16);
    const now = Date.now();
    const code = String(Math.floor(100000 + Math.random() * 900000));
    await this.pool.query(
      `INSERT INTO harbor_users
       (id, email, password_hash, password_salt, plan, created_at, updated_at, disabled, email_verified, verify_code, verify_expires)
       VALUES ($1,$2,$3,$4,'free',$5,$5,0,0,$6,$7)`,
      [userId, email, hashPassword(password, salt), salt.toString("base64"), now, code, now + 86400000],
    );
    return {
      userId,
      token: await this.issueToken(userId),
      plan: "free",
      emailVerified: false,
      verifyCode: code,
    };
  }

  async login(
    email: string,
    password: string,
  ): Promise<{ userId: string; token: string; plan: PlanId; emailVerified: boolean }> {
    const r = await this.pool.query(
      `SELECT id, password_hash, password_salt, plan, disabled, email_verified
       FROM harbor_users WHERE email = $1`,
      [email],
    );
    const row = r.rows[0];
    if (!row) throw new ApiError("邮箱或密码错误", 401);
    if (row.disabled) throw new ApiError("账号已禁用", 403);
    const salt = Buffer.from(row.password_salt, "base64");
    if (!verifyPassword(password, salt, row.password_hash)) {
      throw new ApiError("邮箱或密码错误", 401);
    }
    return {
      userId: row.id,
      token: await this.issueToken(row.id),
      plan: row.plan || "free",
      emailVerified: Boolean(row.email_verified),
    };
  }

  async verifyEmail(email: string, code: string): Promise<{ userId: string; token: string }> {
    const r = await this.pool.query(
      `SELECT id, verify_code, verify_expires, email_verified FROM harbor_users WHERE email = $1`,
      [email],
    );
    const row = r.rows[0];
    if (!row) throw new ApiError("用户不存在", 404);
    if (row.email_verified) return { userId: row.id, token: await this.issueToken(row.id) };
    if (!row.verify_code || row.verify_code !== code) throw new ApiError("验证码不正确", 400);
    if (row.verify_expires && Date.now() > Number(row.verify_expires)) {
      throw new ApiError("验证码已过期，请重新获取", 400);
    }
    await this.pool.query(
      `UPDATE harbor_users SET email_verified=1, verify_code=NULL, verify_expires=NULL, updated_at=$2 WHERE id=$1`,
      [row.id, Date.now()],
    );
    return { userId: row.id, token: await this.issueToken(row.id) };
  }

  async resendVerifyCode(email: string): Promise<{ code: string }> {
    const r = await this.pool.query(
      `SELECT id, email_verified FROM harbor_users WHERE email = $1`,
      [email],
    );
    const row = r.rows[0];
    if (!row) throw new ApiError("用户不存在", 404);
    if (row.email_verified) throw new ApiError("邮箱已验证", 400);
    const code = String(Math.floor(100000 + Math.random() * 900000));
    await this.pool.query(
      `UPDATE harbor_users SET verify_code=$2, verify_expires=$3, updated_at=$4 WHERE id=$1`,
      [row.id, code, Date.now() + 86400000, Date.now()],
    );
    return { code };
  }

  async isEmailVerified(userId: string): Promise<boolean> {
    const r = await this.pool.query(`SELECT email_verified FROM harbor_users WHERE id=$1`, [userId]);
    return Boolean(r.rows[0]?.email_verified);
  }

  async adminMarkVerified(userId: string): Promise<void> {
    await this.pool.query(
      `UPDATE harbor_users SET email_verified=1, verify_code=NULL, verify_expires=NULL, updated_at=$2 WHERE id=$1`,
      [userId, Date.now()],
    );
  }

  async changePassword(userId: string, oldPassword: string, newPassword: string): Promise<{ token: string }> {
    if (newPassword.length < 6) throw new ApiError("新密码至少 6 位", 400);
    const r = await this.pool.query(
      `SELECT password_hash, password_salt FROM harbor_users WHERE id=$1`,
      [userId],
    );
    const row = r.rows[0];
    if (!row) throw new ApiError("用户不存在", 404);
    const salt = Buffer.from(row.password_salt, "base64");
    if (!verifyPassword(oldPassword, salt, row.password_hash)) {
      throw new ApiError("旧密码不正确", 401);
    }
    const newSalt = randomBytes(16);
    await this.pool.query(
      `UPDATE harbor_users SET password_hash=$2, password_salt=$3, updated_at=$4 WHERE id=$1`,
      [userId, hashPassword(newPassword, newSalt), newSalt.toString("base64"), Date.now()],
    );
    await this.pool.query(
      `UPDATE harbor_tokens SET revoked_at=$2 WHERE user_id=$1 AND revoked_at IS NULL`,
      [userId, Date.now()],
    );
    return { token: await this.issueToken(userId) };
  }

  async logout(token: string): Promise<void> {
    await this.pool.query(
      `UPDATE harbor_tokens SET revoked_at=$2 WHERE token_hash=$1 AND revoked_at IS NULL`,
      [sha256(token), Date.now()],
    );
  }

  private async issueToken(userId: string): Promise<string> {
    const token = randomBytes(32).toString("base64url");
    await this.pool.query(
      `INSERT INTO harbor_tokens (token_hash, user_id, created_at) VALUES ($1,$2,$3)`,
      [sha256(token), userId, Date.now()],
    );
    return token;
  }

  async auth(token: string): Promise<{ userId: string; email: string; plan: PlanId }> {
    const r = await this.pool.query(
      `SELECT t.user_id, u.email, u.plan, u.disabled
       FROM harbor_tokens t JOIN harbor_users u ON u.id = t.user_id
       WHERE t.token_hash=$1 AND t.revoked_at IS NULL`,
      [sha256(token)],
    );
    const row = r.rows[0];
    if (!row) throw new ApiError("无效 token，请重新登录", 401);
    if (row.disabled) throw new ApiError("账号已禁用", 403);
    await this.pool.query(`UPDATE harbor_tokens SET last_used_at=$2 WHERE token_hash=$1`, [
      sha256(token),
      Date.now(),
    ]);
    return { userId: row.user_id, email: row.email, plan: row.plan || "free" };
  }

  async usage(userId: string): Promise<{ sessions: number; storageMb: number }> {
    const r = await this.pool.query(
      `SELECT COUNT(*) AS n, COALESCE(SUM(bytes),0) AS b
       FROM harbor_objects WHERE user_id=$1 AND path LIKE '%.harbor.enc.json'`,
      [userId],
    );
    const n = Number(r.rows[0]?.n || 0);
    const b = Number(r.rows[0]?.b || 0);
    return { sessions: n, storageMb: Math.round((b / 1048576) * 10) / 10 };
  }

  async setPlan(userId: string, plan: PlanId): Promise<void> {
    await this.pool.query(`UPDATE harbor_users SET plan=$2, updated_at=$3 WHERE id=$1`, [
      userId,
      plan,
      Date.now(),
    ]);
  }

  async setDisabled(userId: string, disabled: boolean): Promise<void> {
    await this.pool.query(`UPDATE harbor_users SET disabled=$2, updated_at=$3 WHERE id=$1`, [
      userId,
      disabled ? 1 : 0,
      Date.now(),
    ]);
    if (disabled) {
      await this.pool.query(
        `UPDATE harbor_tokens SET revoked_at=$2 WHERE user_id=$1 AND revoked_at IS NULL`,
        [userId, Date.now()],
      );
    }
  }

  async listUsers() {
    const r = await this.pool.query(
      `SELECT id, email, plan, disabled, created_at, email_verified FROM harbor_users ORDER BY created_at DESC`,
    );
    const out = [];
    for (const row of r.rows) {
      const u = await this.usage(row.id);
      out.push({
        id: row.id,
        email: row.email,
        plan: row.plan,
        disabled: row.disabled,
        created_at: Number(row.created_at),
        email_verified: row.email_verified,
        sessions: u.sessions,
        storageMb: u.storageMb,
      });
    }
    return out;
  }

  async listUserObjects(userId: string) {
    const r = await this.pool.query(
      `SELECT path, bytes, mtime FROM harbor_objects WHERE user_id=$1 ORDER BY path`,
      [userId],
    );
    return r.rows.map((row: QueryResultRow) => ({
      path: row.path as string,
      bytes: Number(row.bytes),
      mtime: Number(row.mtime),
    }));
  }

  async getObject(userId: string, rel: string): Promise<Buffer | null> {
    const r = await this.pool.query(
      `SELECT body FROM harbor_objects WHERE user_id=$1 AND path=$2`,
      [userId, rel],
    );
    return r.rows[0]?.body ? Buffer.from(r.rows[0].body) : null;
  }

  async putObject(userId: string, rel: string, body: Buffer): Promise<void> {
    await this.pool.query(
      `INSERT INTO harbor_objects (user_id, path, body, bytes, mtime)
       VALUES ($1,$2,$3,$4,$5)
       ON CONFLICT (user_id, path) DO UPDATE SET body=EXCLUDED.body, bytes=EXCLUDED.bytes, mtime=EXCLUDED.mtime`,
      [userId, rel, body, body.length, Date.now()],
    );
  }

  async objectExists(userId: string, rel: string): Promise<boolean> {
    const r = await this.pool.query(
      `SELECT 1 FROM harbor_objects WHERE user_id=$1 AND path=$2`,
      [userId, rel],
    );
    return Boolean(r.rowCount);
  }

  async stats() {
    const users = await this.pool.query(`SELECT COUNT(*) AS n FROM harbor_users`);
    const disabled = await this.pool.query(`SELECT COUNT(*) AS n FROM harbor_users WHERE disabled=1`);
    const tokens = await this.pool.query(
      `SELECT COUNT(*) AS n FROM harbor_tokens WHERE revoked_at IS NULL`,
    );
    return {
      users: Number(users.rows[0]?.n || 0),
      disabled: Number(disabled.rows[0]?.n || 0),
      activeTokens: Number(tokens.rows[0]?.n || 0),
      backend: "postgres",
    };
  }
}
